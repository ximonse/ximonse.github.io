{
  "builds": [
    {
      "src": "spatial-view/api/gemini.js",
      "use": "@vercel/node"
    },
    {
      "src": "spatial-view/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/gemini",
      "destination": "/api/gemini"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
